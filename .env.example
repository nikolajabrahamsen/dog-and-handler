# Set these in Vercel: Project Settings -> Environment Variables.
# For local dev with `vercel dev`, copy this to `.env.local` and fill it in
# (that file is gitignored - never commit real keys).

# --- Supabase ---
# Project Settings -> API in your Supabase dashboard.
SUPABASE_URL=https://your-project.supabase.co
# The SERVICE ROLE key (not the anon/public key) - this bypasses Row Level
# Security so the serverless functions can read/write freely. Keep it
# server-side only; it must never be sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Vipps MobilePay ePayment API ---
# portal.vippsmobilepay.com after enabling online payments.
MOBILEPAY_CLIENT_ID=
MOBILEPAY_CLIENT_SECRET=
MOBILEPAY_SUBSCRIPTION_KEY=
MOBILEPAY_MERCHANT_SERIAL_NUMBER=
# https://apitest.vipps.no for sandbox, https://api.vipps.no for production
MOBILEPAY_API_BASE_URL=https://apitest.vipps.no

# --- Admin ---
# Optional allow-list: comma-separated emails that are allowed to use the
# admin panel, even if they have a valid Supabase Auth login. Leave empty
# to allow any account you create in Supabase Auth to be an admin (fine as
# long as you don't enable public sign-ups - see README).
ADMIN_EMAILS=you@example.com

# --- Newsletter emails (Resend) ---
# Sign up at resend.com, verify a sending domain, and create an API key.
RESEND_API_KEY=
# Must use your verified domain, e.g. "Dog & Handler <news@yourdomain.com>"
EMAIL_FROM=
# Any long random string - used to sign one-click unsubscribe links so they
# don't need a login. Changing this later invalidates old unsubscribe links.
NEWSLETTER_UNSUBSCRIBE_SECRET=change-me-to-something-long-and-random

# --- Optional ---
# Only needed if you want to force a specific base URL for redirect/webhook
# links instead of deriving it from the incoming request host.
# PUBLIC_BASE_URL=https://your-app.vercel.app

# --- Scheduled release announcements ---
# Any long random string. Set the SAME value here (Vercel env var) and as
# a GitHub Actions secret named CRON_SECRET in your repo (Settings ->
# Secrets and variables -> Actions). Also add a GitHub secret APP_URL set
# to your live site's URL, e.g. https://hund-og-handler.vercel.app
# (no trailing slash). See .github/workflows/announce-releases.yml.
CRON_SECRET=change-me-to-something-long-and-random
