# Set these in Vercel: Project Settings -> Environment Variables.
# For local dev with `vercel dev`, copy this to `.env.local` and fill it in
# (that file is gitignored - never commit real keys).

# --- Supabase ---
# Project Settings -> API in your Supabase dashboard.
SUPABASE_URL=https://your-project.supabase.co
# The SERVICE ROLE key (not the anon/public key) - this bypasses Row Level
# Security so the serverless functions can read/write freely. Keep it
# server-side only; it must never be sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Vipps MobilePay ePayment API ---
# portal.vippsmobilepay.com after enabling online payments.
MOBILEPAY_CLIENT_ID=
MOBILEPAY_CLIENT_SECRET=
MOBILEPAY_SUBSCRIPTION_KEY=
MOBILEPAY_MERCHANT_SERIAL_NUMBER=
# https://apitest.vipps.no for sandbox, https://api.vipps.no for production
MOBILEPAY_API_BASE_URL=https://apitest.vipps.no

# --- Admin ---
# Optional allow-list: comma-separated emails that are allowed to use the
# admin panel, even if they have a valid Supabase Auth login. Leave empty
# to allow any account you create in Supabase Auth to be an admin (fine as
# long as you don't enable public sign-ups - see README).
ADMIN_EMAILS=you@example.com

# --- Optional ---
# Only needed if you want to force a specific base URL for redirect/webhook
# links instead of deriving it from the incoming request host.
# PUBLIC_BASE_URL=https://your-app.vercel.app
